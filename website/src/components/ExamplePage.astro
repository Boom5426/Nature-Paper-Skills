---
import {type Locale,text,source,url} from '../lib/site';
import repository from '../data/repository.json';
import PageHeader from './PageHeader.astro';
import Example from './Example.astro';
import CopyBox from './CopyBox.astro';
interface Props{locale:Locale}
const {locale}=Astro.props;
const prompt=text(locale,'Use paper-workflow. Read examples/first-run/draft.md and examples/first-run/evidence.md. Revise only the Results paragraph using the supplied evidence. Write the revision to examples/first-run/revised.md and briefly explain the material changes. Preserve measured values and figure references.','用 paper-workflow。读取 examples/first-run/draft.md 和 examples/first-run/evidence.md，依据证据只修改这段 Results。将修订版写入 examples/first-run/revised.md，简要说明关键改动。保留测量值及图号。');
---
<PageHeader locale={locale} route="examples/first-revision" eyebrow={text(locale,'A SMALL TASK. A COMPLETE EVIDENCE CHAIN.','一个小任务，一条完整证据链。')} description={text(locale,'This fictional, self-contained example shows how the workflow is intended to revise a Results paragraph. Read the draft, examine the evidence and compare one acceptable reference revision.','这个独立的虚构案例展示工作流预期如何修订一段 Results。阅读原稿、检查证据，再对照一个可接受的参考修订。英文原文直接来自仓库文件。')}/>
<div class="container page-content"><Example locale={locale} full/>
<div class="tutorial-prompt"><h2>{text(locale,'Run it in your own agent.','在你自己的 Agent 中运行。')}</h2><p class="small" style="margin-bottom:18px">{text(locale,'After installation, open this repository in your agent, then use the request below. Inspect your output before reading expected.md; the reference is not an exact answer to copy.','安装后，在 Agent 中打开本仓库，再使用下面的指令。先检查自己的输出，再读取 expected.md；参考修订不是要求逐字复制的标准答案。')} <a class="text-link" href={url(locale,'install')}>{text(locale,'Installation guide','安装指南')} →</a></p><CopyBox locale={locale} id="tutorial-prompt" content={prompt}/></div>
<div class="workflow-explain"><article><h3>{text(locale,'Preserve the measurements','保留测量结果')}</h3><p>{text(locale,'Keep the independent unit, both effect sizes and confidence intervals, and Fig. 1a/1b. Do not turn cultures into cells or invent a P value.','保留独立单位、两项效应量与置信区间，以及 Fig. 1a/1b。不能把培养样本改成细胞，也不能虚构 P 值。')}</p></article><article><h3>{text(locale,'Correct the unsupported conclusion','纠正缺乏支持的结论')}</h3><p>{text(locale,'The marker-expression finding stays. A demonstrated survival improvement or an untested mechanism must not be written into the paragraph.','保留标记物表达的发现。不能把“已证明生存改善”或未经检验的机制补写进段落。')}</p></article><article><h3>{text(locale,'Stay within the task','保留任务边界')}</h3><p>{text(locale,'Only one paragraph is in scope. No full submission audit, invented figures or extra experiments are required to complete this tutorial.','本次只处理一个段落。完成这个教程不需要整套投稿审计，也不能虚构图形或额外实验。')}</p></article></div>
<div class="raw-sources"><h2 style="font-size:29px;margin-bottom:15px">{text(locale,'Read the original materials','阅读原始材料')}</h2>{(['draft','evidence','expected'] as const).map(key=><details><summary><code>examples/first-run/{key}.md</code></summary><pre lang="en" tabindex="0">{repository.example.raw[key]}</pre><p style="padding:0 20px 20px"><a class="text-link" href={source(`examples/first-run/${key}.md`)} target="_blank" rel="noopener noreferrer">{text(locale,'View original on GitHub','在 GitHub 查看原文')} ↗</a></p></details>)}</div></div>
