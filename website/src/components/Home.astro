---
import {type Locale,text,url,source,labels} from '../lib/site';
import repository from '../data/repository.json';
import {taskDefinitions,pick} from '../data/content';
import EvidencePreview from './EvidencePreview.astro';
import WorkflowMap from './WorkflowMap.astro';
import Contracts from './Contracts.astro';
import Example from './Example.astro';
interface Props{locale:Locale}
const {locale}=Astro.props;const copy=labels(locale);
---
<section class="hero"><div class="container hero-grid">
 <div><div class="eyebrow"><span class="dot"></span>{text(locale,'OPEN-SOURCE · SCIENTIFIC WRITING WORKFLOW','开源 · 科研论文工作流')}</div>
 <h1>{text(locale,'Build the argument','先建立清晰论证，')}<br/><span class="serif-em">{text(locale,'before polishing','再打磨论文语言。')}</span>{locale==='en'&&<><br/>the prose.</>}</h1>
 <p class="hero-description">{text(locale,'A modular workflow for Codex and Claude Code that connects scientific claims, evidence, figures, writing, citations and reviewer responses.','面向 Codex 与 Claude Code 的模块化工作流，连接科学论断、实验证据、图表、写作、引用核验与审稿回复。')}</p>
 <p class="hero-support">{text(locale,'From first draft to submission. Built for life-science and computational-methods manuscripts—at the scale your task needs.','从初稿到投稿和返修，聚焦生命科学与计算方法论文。整篇、章节或段落，按你的任务范围进入。')}</p>
 <div class="actions"><a class="button primary" href={url(locale,'install')}>{copy.getStarted}<span aria-hidden="true">→</span></a><a class="button" href={url(locale,'examples/first-revision')}>{copy.example}<span aria-hidden="true">↗</span></a></div>
 <div class="hero-stats"><div><strong>{repository.counts.all}</strong><span>{text(locale,'specialized skills','个专门技能')}</span></div><div><strong>{repository.counts.recommended}</strong><span>{text(locale,'manuscript essentials','个写作审稿技能')}</span></div><div><strong>01</strong><span>{text(locale,'connected workflow','套连贯工作流')}</span></div></div>
 </div><EvidencePreview locale={locale}/>
</div></section>
<div class="intro-strip"><div class="container"><p>{text(locale,'Your research. Your evidence. A clearer manuscript.','你的研究，你的证据，更清晰的论文。')}</p><p>{text(locale,'Start with','统一入口')} <code>paper-workflow</code><span aria-hidden="true"> · </span>{text(locale,'No need to memorize every skill.','无需记住每个技能名。')}</p></div></div>
<section class="section white"><div class="container"><div class="section-head"><div><div class="eyebrow"><span class="section-index">01 /</span>{text(locale,'BEYOND SENTENCE POLISH','不止文字润色')}</div><h2>{text(locale,'Scientific writing starts before the sentence.','科学写作，不始于文字润色。')}</h2></div><p>{text(locale,'A smoother sentence is not always a stronger paper. Connect the claim, the evidence and the job each section needs to do.','句子更流畅，并不等于论文更有说服力。关键是连接论断、证据与章节应有的职责。')}</p></div>
 <div class="pillars">
  <article class="pillar"><div class="mini-diagram" aria-hidden="true"><span>{text(locale,'Question','问题')}</span><i class="line"></i><span>{text(locale,'Evidence','证据')}</span><i class="line"></i><span>{text(locale,'Claim','论断')}</span></div><h3>{text(locale,'Claims before style','论断先于语言')}</h3><p>{text(locale,'Build the argument before refining its wording. Do not make an unsupported conclusion sound more convincing.','先完善论证，再打磨措辞。不要把缺乏证据的结论写得更有说服力。')}</p><a class="text-link" href={url(locale,'workflow')}>{text(locale,'Follow the logic','了解论证路径')} →</a></article>
  <article class="pillar"><div class="mini-diagram" aria-hidden="true"><span class="evidence-token">n</span><span class="evidence-token">Δ</span><span class="evidence-token">95% CI</span><span class="evidence-token">Fig.</span></div><h3>{text(locale,'Preserve what matters','保留关键证据')}</h3><p>{text(locale,'Keep measured values, independent units, negative results and necessary conditions intact throughout the edit.','在修订中保留测量值、独立单位、阴性结果与必要条件。')}</p><a class="text-link" href={url(locale,'examples/first-revision')}>{text(locale,'See the difference','查看修改前后')} →</a></article>
  <article class="pillar"><div class="mini-diagram" aria-hidden="true"><span class="document"><i></i><i></i><i></i><i></i></span><i class="line"></i><span class="document"><i></i><i></i><i></i><i></i></span><i class="line"></i><span class="document"><i></i><i></i><i></i><i></i></span></div><h3>{text(locale,'Each section has a job','每章都有明确职责')}</h3><p>{text(locale,'Give the Abstract, Results and Discussion distinct roles, while keeping their scientific claims aligned.','让摘要、结果和讨论各司其职，同时保持科学论断一致。')}</p><a class="text-link" href="#section-contracts">{text(locale,'Explore section contracts','查看章节职责')} →</a></article>
 </div></div></section>
<section class="section" id="workflow"><div class="container"><div class="section-head"><div><div class="eyebrow"><span class="section-index">02 /</span>{text(locale,'ONE CONNECTED WORKFLOW','一套连贯工作流')}</div><h2>{text(locale,'Start where your manuscript needs help.','从论文需要帮助的地方开始。')}</h2></div><p>{text(locale,'Enter at any stage. A paragraph edit does not require a whole-paper pipeline.','任意阶段都能进入。修改一个段落，不需要执行整套论文流程。')}</p></div><WorkflowMap locale={locale}/></div></section>
<section class="section white" id="tasks"><div class="container"><div class="section-head"><div><div class="eyebrow"><span class="section-index">03 /</span>{text(locale,'YOUR NEXT TASK','你当前的任务')}</div><h2>{text(locale,'What are you working on?','你现在想解决什么问题？')}</h2></div><a class="text-link" href={url(locale,'tasks')}>{text(locale,'All use cases & prompts','全部任务与提示词')} →</a></div><div class="tasks-grid">{taskDefinitions.map((task,i)=><a class="task-card" href={url(locale,`tasks#${task.id}`)}><span class="task-symbol" aria-hidden="true">0{i+1}</span><h3>{pick(locale,task.title)}</h3><p>{pick(locale,task.summary)}</p><span class="task-bottom">{text(locale,'Inputs, outcomes & a ready-to-use prompt','输入、产出与可用提示词')}<span class="arrow" aria-hidden="true">↗</span></span></a>)}</div></div></section>
<section class="section" id="example"><div class="container"><div class="section-head"><div><div class="eyebrow"><span class="section-index">04 /</span>{text(locale,'SEE WHAT CHANGES','看见实际改变')}</div><h2>{text(locale,'Same evidence. A more accurate claim.','同一份证据，更准确的论断。')}</h2></div><p>{text(locale,'Not stronger-sounding language. A conclusion the supplied results can actually support.','不是把语气改得更强，而是让结论得到已有结果的真实支持。')}</p></div><Example locale={locale}/></div></section>
<Contracts locale={locale}/>
<section class="section white"><div class="container getting-started"><div><div class="eyebrow"><span class="section-index">06 /</span>{text(locale,'MAKE YOUR FIRST REVISION','开始第一次修订')}</div><h2>{text(locale,'Bring the workflow to your agent.','把工作流带进你的 Agent。')}</h2><p>{text(locale,'Use your existing research environment. Install a profile, choose the entry skill and start with a small, self-contained example.','在已有的科研环境中，安装合适的技能组合，选择入口技能，从一个独立的小案例开始。')}</p><div class="first-steps"><span><strong>01</strong>{text(locale,'Choose an agent','选择 Agent')}</span><span><strong>02</strong>{text(locale,'Install a profile','安装技能组合')}</span><span><strong>03</strong>{text(locale,'Revise one paragraph','修订一个段落')}</span></div><div class="actions"><a class="button primary" href={url(locale,'install')}>{text(locale,'Choose your setup','选择安装方式')} →</a><a class="text-link" href={url(locale,'docs')}>{text(locale,'Read the docs','阅读文档')} ↗</a></div></div><div class="terminal"><div class="terminal-header"><span>{text(locale,'YOUR FIRST REQUEST','第一条任务指令')}</span><span>paper-workflow</span></div><pre><span class="prompt-marker">› </span>{text(locale,'Use paper-workflow. Revise the Results paragraph using the supplied evidence.\n\nPreserve measured values and figure references. Save a revised copy and explain the material changes.','使用 paper-workflow，依据提供的证据修改 Results 段落。\n\n保留测量值和图号，保存修订副本，并说明关键改动。')}</pre><div class="terminal-footer">{text(locale,'Run in your agent after installation. No manuscript uploads to this website.','安装后在你的 Agent 中使用。无需向本站上传稿件。')}</div></div></div></section>
<div class="scope-strip"><div class="container scope-grid"><h3>{text(locale,'Useful by design. Clear about its boundaries.','实用，也明确自己的边界。')}</h3><p>{text(locale,'Skills provide instructions and helper scripts—not experimental evidence, a built-in editor or a guarantee of publication.','技能提供工作流说明与辅助脚本，不提供实验证据、内置编辑器或发表保证。')}</p><p>{text(locale,'Your explicit scope and the target journal’s requirements come first. Unavailable tools and unchecked sources remain visible.','你的明确修改范围与目标期刊要求优先。工具不可用或来源未核查时，必须如实说明。')} <a class="text-link" style="font-size:11px" href={source('docs/compatibility.md')} target="_blank" rel="noopener noreferrer">{text(locale,'Compatibility','兼容性说明')} ↗</a></p></div></div>
