---
import {type Locale,text,source} from '../lib/site';
import {taskDefinitions,pick} from '../data/content';
import PageHeader from './PageHeader.astro';
import CopyBox from './CopyBox.astro';
import SkillLinks from './SkillLinks.astro';
interface Props{locale:Locale}
const {locale}=Astro.props;
---
<PageHeader locale={locale} route="tasks" eyebrow={text(locale,'START WITH YOUR QUESTION','从你的问题开始')} description={text(locale,'Choose what you need to improve. Each task spells out the inputs, the deliverable and a request you can use after installing the skills.','选择你需要改善的部分。每个任务都说明所需材料、交付结果，以及安装技能后可以直接使用的指令。')}/>
<div class="container page-content"><nav class="task-jump" aria-label={text(locale,'Jump to a task','跳到任务')}>{taskDefinitions.map(t=><a href={`#${t.id}`}>{pick(locale,t.title)}</a>)}</nav>
{taskDefinitions.map((task,i)=><article id={task.id} class="task-detail"><div><div class="eyebrow">0{i+1} / {text(locale,'USE CASE','任务')}</div><h2>{pick(locale,task.title)}</h2><p>{pick(locale,task.summary)}</p><dl><dt>{text(locale,'What you provide','你提供什么')}</dt><dd>{pick(locale,task.input)}</dd><dt>{text(locale,'What you receive','你得到什么')}</dt><dd>{pick(locale,task.output)}</dd></dl><SkillLinks ids={task.skills}/></div><div><CopyBox locale={locale} id={`task-prompt-${task.id}`} content={pick(locale,task.prompt)}/><p class="task-limit">{pick(locale,task.limit)}</p></div></article>)}
<div class="extra-routes"><div><h3>{text(locale,'Only need a diagnosis?','只需要诊断建议？')}</h3><p>{text(locale,'Say so explicitly: “Identify the main argument problems, rank them by importance and give locations. Do not edit files.” Reviewing and rewriting are different permissions.','明确说明：“定位主要论证问题，按重要性排序并给出位置。不要修改文件。”检查与改写是不同的授权。')}</p></div><div><h3>{text(locale,'Review, survey or Perspective','综述、survey 或 Perspective')}</h3><p>{text(locale,'Build a governing argument and display-item plan using the dedicated Review architecture, rather than forcing an experimental Results structure onto it.','使用专门的综述架构，建立主论证与图表规划，不要强行套用实验论文的 Results 结构。')}</p><a class="text-link" href={source('skills/core/review-article-architecture/SKILL.md')} target="_blank" rel="noopener noreferrer">{text(locale,'Open the specialist','查看专门技能')} ↗</a></div></div></div>
