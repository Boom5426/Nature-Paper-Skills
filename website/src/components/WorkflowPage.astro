---
import {type Locale,text,source,url} from '../lib/site';
import PageHeader from './PageHeader.astro';
import WorkflowMap from './WorkflowMap.astro';
import Contracts from './Contracts.astro';
interface Props{locale:Locale}
const {locale}=Astro.props;
---
<PageHeader locale={locale} route="workflow" eyebrow={text(locale,'SCIENTIFIC FIRST. STYLISTIC SECOND.','先科学，后语言。')} description={text(locale,'From the scientific question to submission, keep the evidence connected. These stages describe how the work fits together—not five mandatory steps for every edit.','从科学问题到投稿，始终连接证据。这里展示的是各项工作如何衔接，并不是每次修改都必须经历的五个步骤。')}/>
<div class="container page-content"><WorkflowMap locale={locale}/><div class="callout"><p>{text(locale,'Start at any level: a full paper, one section or a single paragraph. A diagnosis request produces findings. A revision request authorizes changes only within its stated scope.','从任意层级开始：整篇论文、单个章节或一个段落。诊断请求只产生问题与建议；修订请求只授权指定范围内的修改。')}</p></div><div class="workflow-explain"><article><h3>{text(locale,'Fix the argument before its wording','先处理论证，再处理措辞')}</h3><p>{text(locale,'Check whether the question, claim and evidence support each other. Then address section logic, passage clarity and sentence style where a problem actually exists. Sound layers do not need a rewrite.','先确认问题、论断与证据是否相互支持，再处理确有问题的章节逻辑、段落清晰度与句子表达。没有问题的层次不需要重写。')}</p></article><article><h3>{text(locale,'Keep integrity checks separate','区分不同的核查问题')}</h3><p>{text(locale,'Statistical reporting, bibliography consistency, source existence and claim support answer different questions. A source that cannot be accessed is not a source that has passed verification.','统计报告、文献元数据一致性、文献存在性与论断支持回答不同问题。无法访问的来源，不能被视为已经通过核验。')}</p></article><article><h3>{text(locale,'Recheck connected claims, not everything','核对相关论断，不重写全部内容')}</h3><p>{text(locale,'When a Results claim changes, recheck the places that restate it. A focused consistency check does not authorize rewriting protected passages or reopening settled scientific decisions.','Results 的论断变化后，核对其他章节复述它的位置。定向一致性检查不等于授权改写受保护文字，或重新讨论已确认的科学决定。')}</p></article></div><div class="extra-routes"><div><h3>{text(locale,'Writing a Review or Perspective?','正在撰写综述或 Perspective？')}</h3><p>{text(locale,'Use the article-type-specific architecture. A long research paper does not become a Review just because it is long.','使用与文章类型对应的结构。研究论文不会仅仅因为篇幅较长，就变成综述。')}</p><a class="text-link" href={source('skills/core/review-article-architecture/SKILL.md')} target="_blank" rel="noopener noreferrer">{text(locale,'Review architecture','综述结构')} ↗</a></div><div><h3>{text(locale,'Ready for a concrete task?','准备开始具体任务？')}</h3><p>{text(locale,'Choose the input and outcome you need, then copy a request into your agent. The site itself does not run the workflow.','选择所需的输入与产出，再把任务指令复制给 Agent。本站本身不运行这些工作流。')}</p><a class="text-link" href={url(locale,'tasks')}>{text(locale,'Choose a use case','选择任务')} →</a></div></div></div>
<Contracts locale={locale}/>
<div class="container section"><a class="text-link" href={source('docs/workflow-map.md')} target="_blank" rel="noopener noreferrer">{text(locale,'Read the source workflow map and routing rules','阅读仓库中的工作流与路由规则')} ↗</a></div>
